<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:background="@drawable/bg_header"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 FF BOOSTER"
            android:textColor="#FF6A00"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v4.2 • Free Fire &amp; Free Fire MAX"
            android:textColor="#FF8800"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- ===== WARNING ===== -->
    <TextView
        android:id="@+id/tv_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="#1A1A1A"
        android:text="⚠️ ACTIVATE ALL PERMISSIONS FOR PANEL TO WORK"
        android:textColor="#FF4444"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- ===== GAME SELECTION ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎮 SELECT GAME"
        android:textColor="#FF6A00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_ff"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="FREE FIRE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_dark"/>

        <Button
            android:id="@+id/btn_ffmax"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="FF MAX"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_dark"/>

    </LinearLayout>

    <!-- ===== SELECTED ===== -->
    <TextView
        android:id="@+id/tv_selected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#1A1A1A"
        android:text="❌ No game selected"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- ===== CHEATS ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💀 SELECT CHEAT"
        android:textColor="#FF6A00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:id="@+id/ll_cheats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_hs50"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="HS 50%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_dark"/>

            <Button
                android:id="@+id/btn_hs65"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="HS 65%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_dark"/>

            <Button
                android:id="@+id/btn_badan80"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Badan 80%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_dark"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_badanhs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Badan + HS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_dark"/>

            <Button
                android:id="@+id/btn_magicbullet"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🔮 Magic Bullet"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_dark"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== CONFIRM BUTTON ===== -->
    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔒 Select Game &amp; Cheat"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_dark"
        android:enabled="false"
        android:layout_marginBottom="16dp"/>

    <!-- ===== FOOTER ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v4.2.0 • Free Fire Booster Panel"
        android:textColor="#444444"
        android:textSize="10sp"/>

</LinearLayout>
